# ================================
# EDIFICIO ALCATRAZ — CONFIG
# ================================

# Base de datos Supabase (PostgreSQL)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Redis (cola de tareas — en Docker local es redis://redis:6379/0)
REDIS_URL=redis://redis:6379/0


# JWT
SECRET_KEY=cambia-esto-por-una-clave-secreta-muy-larga
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Cloudinary (comprobantes de pago)
CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=tu-api-key
CLOUDINARY_API_SECRET=tu-api-secret

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=tu-account-sid
TWILIO_AUTH_TOKEN=tu-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Resend (Email)
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=notificaciones@edificioalcatraz.com

# Condominio
CONDOMINIO_NOMBRE=Edificio Alcatraz
CONDOMINIO_RIF=J-00000000-0
CONDOMINIO_BANCO=Banco de Venezuela
CONDOMINIO_CUENTA=0102-0000-00-0000000000
CONDOMINIO_PAGO_MOVIL=0414-0000000
CONDOMINIO_PORTAL_URL=https://alcatraz.vercel.app

# BCV Scraping
BCV_URL=https://www.bcv.org.ve/
