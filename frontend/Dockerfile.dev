# ================================================================
#  Frontend Dockerfile.dev — Desarrollo con Vite (Hot Module Replacement)
# ================================================================

FROM node:22-alpine

WORKDIR /app

COPY package*.json ./
RUN npm ci --silent

COPY . .

EXPOSE 5173

# Vite escucha en todas las interfaces para ser accesible desde el host
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
